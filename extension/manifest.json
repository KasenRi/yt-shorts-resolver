{
  "manifest_version": 3,
  "name": "YT Shorts Resolver",
  "description": "Inject a download button into YouTube, resolve available media streams, and merge separate audio/video tracks inside the extension when needed.",
  "version": "2.0.0",
  "permissions": [
    "downloads",
    "offscreen",
    "tabs"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://*.googlevideo.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "page-bridge.js"
      ],
      "matches": [
        "https://www.youtube.com/*"
      ]
    }
  ]
}
